# Database
DATABASE_URL=postgresql://app:devpassword@localhost:5432/unified_inbox

# Google OAuth (create at console.cloud.google.com)
# 1. Create project → Enable Gmail API
# 2. OAuth consent screen → External → add your email as test user
# 3. Credentials → OAuth 2.0 Client ID → Web application
# 4. Add redirect URI matching your GOOGLE_REDIRECT_URI value below
#
# IMPORTANT: Google OAuth does NOT accept bare IP addresses as redirect URIs.
# Use a real hostname — even one that resolves to a private/LAN IP is fine.
# The app will not be reachable from the internet if the IP is private.
# Options:
#   a) A subdomain you own pointing to your private IP via DNS A record
#      e.g.  inbox.yourdomain.com  →  192.168.1.x
#   b) A local alias in /etc/hosts on every client machine
#      e.g.  add "192.168.1.x inbox.local" to /etc/hosts, use http://inbox.local:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://inbox.yourdomain.com:3000/api/auth/callback

# Token encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# App access password — set any strong password here
APP_SECRET=

# Base URL (used for OAuth redirects)
APP_URL=http://inbox.yourdomain.com:3000

# Todoist integration (optional)
# API token: todoist.com → Settings → Integrations → Developer → API token
TODOIST_API_KEY=
# Optional: send tasks to a specific project (get ID from todoist.com project URL)
TODOIST_PROJECT_ID=

# Set to "true" to log every synced thread to the activity log (high-volume; off by default)
SYNC_LOG_THREADS=

# Ollama local LLM (optional — powers AI task suggestions in email viewer)
# Run ollama locally: https://ollama.com — default port is 11434
# Example: OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=
# Model to use — must be pulled first: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
