generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum WorkItemStatus {
  NEW
  ACTIVE
  WAITING
  DELEGATED
  TODOIST
  DONE
}

enum TaskProvider {
  TODOIST
  OPENPROJECT
}

enum RuleAction {
  SUGGEST_DOMAIN
  AUTO_ASSIGN_DOMAIN
  SUGGEST_WORK_ITEM
  FLAG_FOR_REVIEW
}

enum ActivityEventType {
  ACCOUNT_CONNECTED
  ACCOUNT_DISCONNECTED
  ACCOUNT_SYNC_STARTED
  ACCOUNT_SYNC_COMPLETED
  ACCOUNT_SYNC_FAILED
  THREAD_IMPORTED
  THREAD_UPDATED
  THREAD_STALE
  WORK_ITEM_CREATED
  WORK_ITEM_UPDATED
  WORK_ITEM_STATUS_CHANGED
  THREAD_ATTACHED
  THREAD_DETACHED
  DOMAIN_ASSIGNED
  TASK_EXPORTED
  TASK_SYNC_UPDATED
  RULE_APPLIED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Account {
  id             String    @id @default(uuid())
  accountType    String    @default("GMAIL") // "GMAIL" | "IMAP"
  email          String    @unique
  displayName    String
  accessToken    String // encrypted; for IMAP this is the password
  refreshToken   String? // encrypted; null for IMAP accounts
  tokenExpiresAt DateTime? // null for IMAP accounts
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?
  historyId      String? // Gmail history ID or "uid:<n>" for IMAP
  color          String    @default("#6366f1") // user-chosen account color
  imapHost       String?
  imapPort       Int?
  smtpHost       String?
  smtpPort       Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  threads      ThreadMirror[]
  activityLogs ActivityLog[]
  labels       Label[]
  syncJobs     SyncJob[]
}

model SyncJob {
  id          String    @id @default(uuid())
  accountId   String
  status      String    @default("pending") // "pending" | "running" | "done" | "failed"
  claimedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([accountId, status])
}

model ThreadMirror {
  id                   String    @id @default(uuid())
  gmailThreadId        String
  accountId            String
  subject              String
  snippet              String    @db.Text
  participantAddresses String[]
  gmailLabelIds        String[]
  messageCount         Int
  hasAttachments       Boolean   @default(false)
  isUnread             Boolean   @default(false)
  lastMessageAt        DateTime
  firstMessageAt       DateTime
  historyId            String?
  syncedAt             DateTime  @default(now())
  isStale              Boolean   @default(false)
  isFlagged            Boolean   @default(false)
  snoozedUntil         DateTime?
  workItemId           String?
  domainId             String? // suggested/assigned domain (independent of work item)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  domain   Domain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@unique([gmailThreadId, accountId])
  @@index([accountId])
  @@index([workItemId])
  @@index([domainId])
  @@index([lastMessageAt])
  @@index([isUnread])
  @@index([isStale])
  @@index([snoozedUntil])
  // Compound indexes for common query patterns
  @@index([accountId, isStale, lastMessageAt])
  @@index([domainId, isStale, lastMessageAt])
  @@index([workItemId, isStale])
  // Unfiltered inbox/today: WHERE isStale = false AND lastMessageAt >= cutoff
  // ORDER BY lastMessageAt DESC (no accountId/domainId prefix available)
  @@index([isStale, lastMessageAt])
}

model Label {
  id           String  @id @default(uuid())
  accountId    String
  gmailLabelId String // e.g. "Label_123" for user labels, "INBOX" for system
  name         String
  color        String? // hex from Gmail label backgroundColor
  type         String  @default("user") // "system" | "user"

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, gmailLabelId])
  @@index([accountId])
}

model Domain {
  id            String   @id @default(uuid())
  name          String   @unique
  color         String   @default("#6366f1")
  description   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  kanbanColumns Json? // KanbanColumnConfig[] — null means use defaults
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workItems WorkItem[]
  threads   ThreadMirror[]
  rules     Rule[]
}

model WorkItem {
  id             String         @id @default(uuid())
  title          String
  summary        String?        @db.Text
  status         WorkItemStatus @default(NEW)
  domainId       String?
  dueDate        DateTime?
  remindAt       DateTime? // when to fire a push reminder (independent of dueDate)
  reminderSentAt DateTime? // set once the remindAt reminder has been delivered
  notes          String?        @db.Text
  checklist      Json? // [{text: string, done: boolean}]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  domain       Domain?        @relation(fields: [domainId], references: [id])
  threads      ThreadMirror[]
  taskLinks    TaskLink[]
  activityLogs ActivityLog[]

  @@index([domainId])
  @@index([status])
  @@index([dueDate])
  @@index([status, domainId])
  // Drives the worker's reminder scan: unsent reminders that are now due.
  @@index([remindAt, reminderSentAt])
}

model TaskLink {
  id             String       @id @default(uuid())
  workItemId     String
  provider       TaskProvider
  externalId     String
  externalUrl    String?
  externalTitle  String?
  externalStatus String?
  exportedAt     DateTime     @default(now())
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, provider])
  @@unique([provider, externalId])
}

model Rule {
  id          String     @id @default(uuid())
  name        String
  description String?
  isActive    Boolean    @default(true)
  priority    Int        @default(100)
  conditions  Json // [{field, operator, value}]
  action      RuleAction
  domainId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  domain Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([isActive, priority])
}

// ─── Notifications ──────────────────────────────────────────────────────────

// A browser Web Push subscription (one row per device/browser that opted in).
model PushSubscription {
  id         String   @id @default(uuid())
  endpoint   String   @unique
  p256dh     String // client public key (base64url)
  auth       String // client auth secret (base64url)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
}

// Single-row table holding notification preferences. There is exactly one user,
// so we pin it to a fixed id ("singleton") and upsert.
model NotificationSetting {
  id              String   @id @default("singleton")
  newMailEnabled  Boolean  @default(true)
  reminderEnabled Boolean  @default(true)
  // Quiet hours as 0–23 local hours; null disables. Suppresses new-mail pushes
  // (reminders still fire — a reminder you set is intentional).
  quietHoursStart Int?
  quietHoursEnd   Int?
  updatedAt       DateTime @updatedAt
}

// Single-row table holding the global Kanban board configuration (column order,
// labels, visibility). Per-domain boards override this via Domain.kanbanColumns;
// the global /kanban board uses this. Pinned to a fixed id ("singleton").
model KanbanSetting {
  id        String   @id @default("singleton")
  columns   Json? // KanbanColumnConfig[] — null means use defaults
  updatedAt DateTime @updatedAt
}

// Login sessions. The cookie holds a random token; only its SHA-256 hash is
// stored, so a database leak doesn't yield usable session credentials.
// Deleting a row revokes that session immediately.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

// Single-row table the background worker touches on a short cadence so the
// web app (status panel, /api/health) can tell whether it's alive.
model WorkerStatus {
  id          String   @id @default("singleton")
  startedAt   DateTime @default(now())
  heartbeatAt DateTime @default(now())
}

model ActivityLog {
  id          String            @id @default(uuid())
  eventType   ActivityEventType
  accountId   String?
  workItemId  String?
  description String
  metadata    Json?
  createdAt   DateTime          @default(now())

  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([accountId])
  @@index([workItemId])
  @@index([eventType])
  @@index([createdAt, accountId])
  @@index([eventType, createdAt])
}
